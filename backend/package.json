{
  "name": "fashion-ecommerce-backend",
  "version": "1.0.0",
  "description": "Scalable e-commerce backend for customized fashion store",
  "main": "server/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon server/server.js",
    "dev:staging": "cross-env NODE_ENV=staging nodemon server/server.js",
    "start": "cross-env NODE_ENV=production node server/server.js",
    "start:staging": "cross-env NODE_ENV=staging node server/server.js",
    "dev:worker:orders": "cross-env NODE_ENV=development nodemon src/workers/orderNotificationWorker.js",
    "worker:orders": "node src/workers/orderNotificationWorker.js",
    "start:pm2": "pm2-runtime ecosystem.config.js --env production",
    "cluster:start": "pm2 start ecosystem.config.js --env production",
    "cluster:stop": "pm2 delete fashion-backend",
    "seed": "node scripts/seed.js",
    "lint": "echo 'No lint configured yet'"
  },
  "keywords": [
    "express",
    "mongodb",
    "ecommerce",
    "fashion"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^8.42.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.56.7",
    "cloudinary": "^2.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pm2": "^5.4.3",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "stripe": "^17.5.0",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.9"
  }
}
