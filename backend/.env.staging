NODE_ENV=staging
PORT=5000

MONGO_URI=mongodb://staging-mongodb:27017/fashion_ecommerce
JWT_SECRET=STAGING_CHANGE_ME_STRONG_JWT_SECRET
REFRESH_TOKEN_SECRET=STAGING_CHANGE_ME_STRONG_REFRESH_SECRET

CLIENT_URL=https://staging.frontend.example.com
CORS_ALLOWED_ORIGINS=https://staging.frontend.example.com
CORS_ALLOW_NO_ORIGIN=false

FORCE_HTTPS=true
REDIS_ENABLED=true
RATE_LIMIT_REDIS_ENABLED=true
SHUTDOWN_TIMEOUT_MS=15000
CIRCUIT_BREAKER_ENABLED=false
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
LOG_LEVEL=info
SENTRY_DSN=
