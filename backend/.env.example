NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/fashion_ecommerce
MONGO_REPLICA_SET=
MONGO_READ_PREFERENCE=primaryPreferred
MONGO_READ_CONCERN_LEVEL=
MONGO_RETRY_READS=true
MONGO_RETRY_WRITES=true
MONGO_SYNC_INDEXES=false
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRE=24h
ACCESS_TOKEN_EXPIRE=15m
ENABLE_REFRESH_TOKENS=false
REFRESH_TOKEN_SECRET=replace_with_refresh_secret
REFRESH_TOKEN_EXPIRE=7d
MAX_REFRESH_TOKENS_PER_USER=5
REDIS_ENABLED=false
REDIS_REQUIRED=false
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=fashion
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RETRY_DELAY_MS=5000
RATE_LIMIT_REDIS_ENABLED=false
RATE_LIMIT_REDIS_URL=redis://localhost:6379
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT=5
REDIS_CATALOG_LIST_TTL_SECONDS=120
REDIS_CATALOG_PRODUCT_TTL_SECONDS=300
REDIS_CATALOG_CATEGORIES_TTL_SECONDS=600
ORDER_EVENTS_ASYNC_ENABLED=true
ORDER_EVENTS_QUEUE_REQUIRED=false
QUEUE_REDIS_URL=redis://localhost:6379
QUEUE_REDIS_DB=0
ORDER_EVENTS_QUEUE_NAME=order-events
ORDER_EVENTS_QUEUE_ATTEMPTS=3
ORDER_EVENTS_QUEUE_BACKOFF_MS=1000
ORDER_EVENTS_WORKER_CONCURRENCY=5
LOG_LEVEL=debug
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ALLOW_NO_ORIGIN=true
API_RATE_LIMIT=100
AUTH_RATE_LIMIT=30
ENABLE_DB_TRANSACTIONS=true
FORCE_HTTPS=false
SHUTDOWN_TIMEOUT_MS=15000
CIRCUIT_BREAKER_ENABLED=false
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
REQUIRE_IDEMPOTENCY_KEY=true
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_SECONDS=90
AUDIT_LOG_TTL_SECONDS=15552000
DB_CONNECT_RETRIES=4
DB_RETRY_ATTEMPTS=2
DB_RETRY_BASE_DELAY_MS=60
DB_RETRY_MAX_DELAY_MS=500
PERF_P95_TARGET_MS=200
PERF_SAMPLE_SIZE=500

STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=

ADMIN_EMAIL=admin@fashionnova.local
ADMIN_PASSWORD=Admin@123
DEMO_USER_EMAIL=user@fashionnova.local
DEMO_USER_PASSWORD=User@123
