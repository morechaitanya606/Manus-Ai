NODE_ENV=development
PORT=5001
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atelier_saas?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_GLOBAL_WINDOW=1 minute
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AI_WINDOW=1 minute

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=usd

OPENAI_API_KEY=
STABLE_DIFFUSION_API_KEY=
AI_PROVIDER=mock

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=atelier-assets
S3_PUBLIC_BASE_URL=http://localhost:9000/atelier-assets

OTEL_ENABLED=false
OTEL_SERVICE_NAME=atelier-api

REQUIRE_IDEMPOTENCY_KEY=true
UPLOAD_MAX_BYTES=10485760
