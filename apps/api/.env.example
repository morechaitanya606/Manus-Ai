# ── Atelier Thread API — Environment Variables ───────────────────
# Copy to .env and fill in values for local development

# ── Server ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
HOST=0.0.0.0
LOG_LEVEL=info

# ── Database (PostgreSQL) ────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atelier_saas?schema=public

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (JWT) ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-string-minimum
JWT_REFRESH_SECRET=change-me-to-another-random-32-char-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_GLOBAL_WINDOW=1 minute
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AI_WINDOW=1 minute

# ── Stripe ───────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_CURRENCY=usd

# ── AI Provider ──────────────────────────────────────────────────
# Options: mock | openai | stable-diffusion
AI_PROVIDER=mock
# OPENAI_API_KEY=sk-xxxx
# STABLE_DIFFUSION_API_KEY=xxxx

# ── S3 / MinIO (Object Storage) ─────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=atelier-assets
S3_PUBLIC_BASE_URL=http://localhost:9000/atelier-assets

# ── Observability ────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=atelier-api

# ── Idempotency ──────────────────────────────────────────────────
REQUIRE_IDEMPOTENCY_KEY=true

# ── Upload Limits ────────────────────────────────────────────────
UPLOAD_MAX_BYTES=10485760
