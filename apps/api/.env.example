# ─── ManusAI API Environment ───

# Server
NODE_ENV=production
PORT=5001
HOST=0.0.0.0
LOG_LEVEL=info

# Database (Neon free tier: https://neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis (Upstash free tier: https://upstash.com)
REDIS_URL=redis://default:password@host:port

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-32-char-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.vercel.app

# Rate Limiting
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_GLOBAL_WINDOW=1 minute
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AI_WINDOW=1 minute

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=inr

# AI Provider (mock = no external API needed)
AI_PROVIDER=mock
OPENAI_API_KEY=
STABLE_DIFFUSION_API_KEY=

# S3 Storage (optional — only for AI design uploads)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=manusai-uploads
# S3_PUBLIC_BASE_URL=https://your-bucket.s3.amazonaws.com

# Telemetry (optional)
OTEL_ENABLED=false

# Other
REQUIRE_IDEMPOTENCY_KEY=true
UPLOAD_MAX_BYTES=10485760
