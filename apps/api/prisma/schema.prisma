generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  STORE_OWNER
  STORE_MANAGER
  CUSTOMER
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DesignJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  plan        String    @default("starter")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  stores      Store[]
  users       User[]
  refreshTokens RefreshToken[]
  categories  Category[]
  products    Product[]
  designJobs  DesignJob[]
  mockups     MockupPreview[]
  carts       Cart[]
  orders      Order[]
  addresses   Address[]
  auditLogs   AuditLog[]
  idempotency IdempotencyKey[]
}

model Store {
  id          String    @id @default(cuid())
  tenantId    String
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  domain      String?
  logoUrl     String?
  themeConfig Json?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  carts       Cart[]
  orders      Order[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model User {
  id            String         @id @default(cuid())
  tenantId      String
  organization  Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String
  passwordHash  String
  displayName   String
  role          Role           @default(CUSTOMER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  carts         Cart[]
  orders        Order[]
  addresses     Address[]
  designJobs    DesignJob[]
  mockups       MockupPreview[]
  auditLogs     AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model RefreshToken {
  id          String   @id @default(cuid())
  tenantId    String
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([tenantId, userId])
}

model Category {
  id          String    @id @default(cuid())
  tenantId    String
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
}

model Product {
  id            String         @id @default(cuid())
  tenantId      String
  organization  Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id])
  title         String
  slug          String
  description   String
  type          String
  basePrice     Decimal        @db.Decimal(10, 2)
  currency      String         @default("USD")
  stock         Int            @default(0)
  reservedStock Int            @default(0)
  sizes         String[]
  colors        String[]
  images        String[]
  metadata      Json?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reservations  StockReservation[]
  mockups       MockupPreview[]

  @@unique([tenantId, slug])
  @@index([tenantId, storeId, isActive])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
}

model DesignJob {
  id            String          @id @default(cuid())
  tenantId      String
  organization  Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt        String
  provider      String
  status        DesignJobStatus @default(QUEUED)
  imageUrl      String?
  metadata      Json?
  errorMessage  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  mockups       MockupPreview[]

  @@index([tenantId, userId, createdAt])
  @@index([tenantId, status])
}

model MockupPreview {
  id            String       @id @default(cuid())
  tenantId      String
  organization  Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  designJobId   String?
  designJob     DesignJob?   @relation(fields: [designJobId], references: [id], onDelete: SetNull)
  color         String
  placement     String
  scale         Float
  positionX     Float
  positionY     Float
  previewUrl    String
  createdAt     DateTime     @default(now())

  @@index([tenantId, userId, createdAt])
}

model Cart {
  id            String       @id @default(cuid())
  tenantId      String
  organization  Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt     DateTime     @updatedAt
  createdAt     DateTime     @default(now())
  items         CartItem[]

  @@unique([tenantId, userId, storeId])
  @@index([tenantId, updatedAt])
}

model CartItem {
  id            String    @id @default(cuid())
  tenantId      String
  cartId        String
  cart          Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int
  unitPrice     Decimal   @db.Decimal(10, 2)
  size          String?
  color         String?
  customization Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, cartId])
  @@index([tenantId, productId])
}

model Order {
  id                    String            @id @default(cuid())
  tenantId              String
  organization          Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId               String
  store                 Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderNumber           String
  status                OrderStatus       @default(CREATED)
  paymentStatus         PaymentStatus     @default(PENDING)
  subtotal              Decimal           @db.Decimal(10, 2)
  tax                   Decimal           @db.Decimal(10, 2)
  totalAmount           Decimal           @db.Decimal(10, 2)
  currency              String            @default("USD")
  stripePaymentIntentId String?
  shippingAddressId     String?
  shippingAddress       Address?          @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  idempotencyKey        String?
  placedAt              DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  items                 OrderItem[]
  reservations          StockReservation[]

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, userId, placedAt])
  @@index([tenantId, status])
  @@index([tenantId, paymentStatus])
}

model OrderItem {
  id            String   @id @default(cuid())
  tenantId      String
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  title         String
  unitPrice     Decimal  @db.Decimal(10, 2)
  quantity      Int
  size          String?
  color         String?
  customization Json?

  @@index([tenantId, orderId])
}

model StockReservation {
  id          String    @id @default(cuid())
  tenantId    String
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  expiresAt   DateTime
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, productId])
  @@index([tenantId, expiresAt])
}

model Address {
  id          String       @id @default(cuid())
  tenantId    String
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  line1       String
  line2       String?
  city        String
  state       String
  postalCode  String
  country     String
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orders      Order[]

  @@index([tenantId, userId])
}

model IdempotencyKey {
  id            String       @id @default(cuid())
  tenantId      String
  organization  Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpoint      String
  idempotencyKey String
  requestHash   String
  responseCode  Int
  responseBody  Json
  createdAt     DateTime     @default(now())

  @@unique([tenantId, endpoint, idempotencyKey])
  @@index([tenantId, createdAt])
}

model AuditLog {
  id            String       @id @default(cuid())
  tenantId      String
  organization  Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String
  entity        String
  entityId      String?
  status        String
  ipAddress     String?
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
}
