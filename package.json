{
  "name": "atelier-thread-saas",
  "version": "2.0.0",
  "private": true,
  "description": "Production-ready multi-tenant SaaS AI-powered custom fashion e-commerce platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @atelier/web",
    "dev:web": "npm run dev --workspace @atelier/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
